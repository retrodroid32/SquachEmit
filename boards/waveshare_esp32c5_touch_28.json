{
  "build": {
    "arduino": {
      "ldscript": "esp32c5_out.ld"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32C5_DEV",
      "-DARDUINO_USB_CDC_ON_BOOT=1"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32c5",
    "variant": "esp32c5"
