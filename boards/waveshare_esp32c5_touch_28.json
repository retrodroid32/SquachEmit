  "name": "Waveshare ESP32-C5 Touch LCD 2.8 (ST7789/CST3530)",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 393216,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 460800
